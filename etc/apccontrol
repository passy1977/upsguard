# /etc/upsguard/apccontrol - called by apcupsd (SCRIPTDIR /etc/upsguard)
# for every event; hands it to upsguard-event.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
exec upsguard-event "$@"
