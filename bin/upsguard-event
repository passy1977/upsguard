#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2026 Antonio Salsi
#
# upsguard-event - apcupsd event handler with mail notification
#
# Called by apcupsd through /etc/upsguard/apccontrol as
#   upsguard-event <event> <upsname> <connected> <powered>
#
# Sends a mail for the events that matter, then hands the events with a real
# action (doshutdown, doreboot, killpower) to the apccontrol of the apcupsd
# package.
#
# Usage (as root, by hand):
#   upsguard-event --test       send a test mail with the UPS status
#   upsguard-event --stdout     print the UPS status, send nothing

# ---------------------------------------------------------------- configuration

MAILTO="root"                               # overridden by /etc/upsguard.env

APCCONTROL="/etc/apcupsd/apccontrol"        # apccontrol of the apcupsd package
STATE_DIR="/run/upsguard"                   # state between events (cleared at boot)
COMM_GRACE=120                              # seconds of lost USB link before the mail
                                            # (hides the short loss after a resume)
BATT_GRACE=60                               # seconds of battery detached before the mail
                                            # (the BX series reports spurious detaches)
CHANGEME_GRACE=120                          # seconds before checking the "replace battery" flag
                                            # (the BX series raises it for an instant)
CHANGEME_REPEAT_MIN=1440                    # repeat the "replace battery" mail once a day
MAIL_WAIT=30                                # seconds to wait for postfix before shutdown
CONFIRM_SEC=30                              # seconds the battery must stay critical before
                                            # a shutdown is carried out (the BX series
                                            # reports a false LOWBATT on every transfer)
CONFIRM_POLL=3                              # interval between two checks (seconds)
CANCEL_REPEAT_MIN=60                        # at most one "shutdown cancelled" mail per hour

[ -r /etc/upsguard.env ] && . /etc/upsguard.env

# ------------------------------------------------------------------------------

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
LC_ALL=C
export LC_ALL

EVENT="$1"
UPS="${2:-UPS}"
HOST="$(hostname)"

status() {
    echo "Host:  $HOST"
    echo "Date:  $(date '+%Y-%m-%d %H:%M:%S %Z')"
    echo
    if command -v apcaccess >/dev/null 2>&1; then
        apcaccess 2>&1 | grep -E '^(MODEL|STATUS|LINEV|LOADPCT|BCHARGE|TIMELEFT|MBATTCHG|MINTIMEL|BATTDATE|NUMXFERS|LASTXFER|XONBATT|TONBATT|CUMONBATT)'
    else
        echo "apcaccess not found"
    fi
}

send_mail() {
    subject="$1"
    shift
    {
        printf 'To: %s\n' "$MAILTO"
        printf 'Subject: [%s] UPS: %s\n' "$HOST" "$subject"
        printf 'Content-Type: text/plain; charset=UTF-8\n'
        printf '\n'
        printf '%s\n' "$@"
        echo
        status
    } | sendmail -t
}

# Waits for postfix to deliver the mail ($MAIL_WAIT seconds at most)
flush_mail() {
    command -v postqueue >/dev/null 2>&1 || return 0
    postqueue -f 2>/dev/null
    i=0
    while [ "$i" -lt "$MAIL_WAIT" ]; do
        postqueue -p 2>/dev/null | grep -q 'queue is empty' && return 0
        sleep 1
        i=$(( i + 1 ))
    done
}

# Mails only if the condition $1 is still set after $2 seconds:
# the matching clear_condition removes it before then for a short glitch
defer_mail() {
    cond="$STATE_DIR/$1"
    grace="$2"
    shift 2
    # Token: a sleeper left over from an earlier glitch must not see a new one
    token="$(date +%s).$$"
    echo "$token" > "$cond"
    (
        sleep "$grace"
        if [ "$(cat "$cond" 2>/dev/null)" = "$token" ] && [ ! -e "$cond.mailed" ]; then
            touch "$cond.mailed"
            send_mail "$@"
        fi
    ) </dev/null >/dev/null 2>&1 &
}

# Clears the condition $1; mails only if defer_mail had mailed it
clear_condition() {
    cond="$STATE_DIR/$1"
    shift
    rm -f "$cond"
    if [ -e "$cond.mailed" ]; then
        rm -f "$cond.mailed"
        send_mail "$@"
    fi
}

# Value of an apcaccess field, without the unit
field() {
    printf '%s\n' "$STATUS_DUMP" | awk -F': *' -v k="$1" '
        { sub(/ +$/, "", $1) }
        $1 == k { split($2, a, " "); print a[1]; exit }'
}

# True if the UPS is really running out of battery right now: on battery, battery
# present, and low battery reported or a limit of apcupsd.conf reached.
# Without an answer from apcupsd it errs on the side of the shutdown.
battery_critical() {
    STATUS_DUMP="$(apcaccess 2>/dev/null)"
    [ -n "$STATUS_DUMP" ] || return 0
    st=" $(printf '%s\n' "$STATUS_DUMP" | sed -n 's/^STATUS *: *//p') "
    case "$st" in *" ONBATT "*) ;; *) return 1 ;; esac
    case "$st" in *" NOBATT "*) return 1 ;; esac
    case "$st" in *" LOWBATT "*) return 0 ;; esac
    charge="$(field BCHARGE)";  charge="${charge%%.*}"
    left="$(field TIMELEFT)";   left="${left%%.*}"
    mincharge="$(field MBATTCHG)"
    minleft="$(field MINTIMEL)"
    [ -n "$charge" ] && [ -n "$mincharge" ] && [ "$charge" -le "$mincharge" ] && return 0
    [ -n "$left" ] && [ -n "$minleft" ] && [ "$left" -le "$minleft" ] && return 0
    return 1
}

# True if battery_critical holds for CONFIRM_SEC seconds without interruption
confirm_critical() {
    waited=0
    while :; do
        battery_critical || return 1
        [ "$waited" -ge "$CONFIRM_SEC" ] && return 0
        sleep "$CONFIRM_POLL"
        waited=$(( waited + CONFIRM_POLL ))
    done
}

# Undoes what apcupsd did when it started the shutdown and restarts it, so
# that it is ready to start a new one
cancel_shutdown() {
    rm -f /etc/apcupsd/powerfail /etc/nologin
    mark="$STATE_DIR/cancelled"
    if [ -z "$(find "$mark" -mmin -"$CANCEL_REPEAT_MIN" 2>/dev/null)" ]; then
        touch "$mark"
        send_mail "shutdown cancelled" \
            "apcupsd started a shutdown ($1), but the battery was not critical" \
            "for $CONFIRM_SEC seconds: false alarm from $UPS, shutdown cancelled."
    fi
    setsid sv restart upsguard </dev/null >/dev/null 2>&1 &
}

delegate() {
    [ -x "$APCCONTROL" ] && exec "$APCCONTROL" "$@"
    echo "upsguard-event: $APCCONTROL not found" >&2
    exit 1
}

mkdir -p "$STATE_DIR"

case "$EVENT" in
    --test)
        send_mail "test" "Test mail from upsguard-event."
        ;;

    --stdout)
        status
        ;;

    onbattery)
        touch "$STATE_DIR/onbattery"
        send_mail "ON BATTERY" "Power failure: $UPS is running on batteries."
        ;;

    offbattery)
        if [ -e "$STATE_DIR/onbattery" ]; then
            rm -f "$STATE_DIR/onbattery"
            send_mail "power restored" "Power has returned on $UPS."
        fi
        ;;

    commfailure)
        # A short loss of the USB link (e.g. on resume from suspend) is normal
        defer_mail commfailure "$COMM_GRACE" "communication lost" \
            "Communication with $UPS lost for more than $COMM_GRACE seconds." \
            "A shutdown on low battery is NOT possible until it comes back."
        ;;

    commok)
        clear_condition commfailure "communication restored" \
            "Communication with $UPS restored."
        ;;

    failing|loadlimit|runlimit|timeout|emergency|remotedown)
        # Reason of the doshutdown that follows: the mail is sent by doshutdown
        echo "$EVENT" > "$STATE_DIR/reason"
        ;;

    changeme)
        # Mail only if apcupsd still reports the flag after CHANGEME_GRACE seconds
        (
            sleep "$CHANGEME_GRACE"
            flag="$(apcaccess -p STATFLAG 2>/dev/null | tr -d ' ')"
            [ -n "$flag" ] && [ $(( flag & 0x80 )) -ne 0 ] || exit 0
            mark="$STATE_DIR/changeme"
            if [ -z "$(find "$mark" -mmin -"$CHANGEME_REPEAT_MIN" 2>/dev/null)" ]; then
                touch "$mark"
                send_mail "REPLACE BATTERY" "The batteries of $UPS have failed: replace them."
            fi
        ) </dev/null >/dev/null 2>&1 &
        ;;

    battdetach)
        # The BX series reports a detach that clears within a second
        defer_mail battdetach "$BATT_GRACE" "battery disconnected" \
            "The battery of $UPS has been disconnected for more than $BATT_GRACE seconds."
        ;;

    battattach)
        clear_condition battdetach "battery reconnected" \
            "The battery of $UPS has been reconnected."
        ;;

    doshutdown)
        # The reason event is started together with doshutdown: give it time
        sleep 1
        reason="$(cat "$STATE_DIR/reason" 2>/dev/null)"
        rm -f "$STATE_DIR/reason"
        case "$reason" in
            timeout|remotedown) ;;
            *)
                if ! confirm_critical; then
                    cancel_shutdown "${reason:-unknown reason}"
                    exit 0
                fi
                ;;
        esac
        case "$reason" in
            failing)    why="Battery power exhausted on $UPS." ;;
            loadlimit)  why="Battery charge below BATTERYLEVEL on $UPS." ;;
            runlimit)   why="Battery runtime below MINUTES on $UPS." ;;
            timeout)    why="Time on battery exceeded TIMEOUT on $UPS." ;;
            emergency)  why="Emergency shutdown: possible battery failure on $UPS." ;;
            remotedown) why="Remote shutdown requested." ;;
            *)          why="Shutdown requested by apcupsd." ;;
        esac
        send_mail "SHUTDOWN" "$why Shutting down."
        flush_mail
        delegate "$@"
        ;;

    doreboot|killpower)
        delegate "$@"
        ;;

    powerout|mainsback|annoyme|startselftest|endselftest)
        ;;

    *)
        echo "Usage: upsguard-event --test|--stdout" >&2
        echo "       (events are sent by apcupsd)" >&2
        exit 2
        ;;
esac

exit 0
